*.log

# env files (can opt-in for committing if needed)
.env
.env.*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/app/generated/prisma

# Generated media and local tools
video_frames/
video_tools/

# Python artifacts from local scripts
__pycache__/
*.pyc

# Editors
.vscode/
.idea/

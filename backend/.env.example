# Pinesphere ERP backend environment
#
# Copy this file to backend/.env for local development or configure the same
# variables in your production secret manager.
#
# Production examples:
# DATABASE_URL=postgresql://pinesphere_user:REPLACE_ME@db.your-domain.com:5432/pinesphere_erp
# FRONTEND_BASE_URL=https://app.your-domain.com
# CORS_ALLOWED_ORIGINS=https://app.your-domain.com,https://staging.your-domain.com

DATABASE_URL=postgresql://pinesphere_user:REPLACE_ME@db.your-domain.com:5432/pinesphere_erp
SECRET_KEY=replace-with-64-plus-random-hex-from-openssl-rand-hex-64
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
KEEP_ME_REFRESH_TOKEN_EXPIRE_DAYS=30
FRONTEND_BASE_URL=https://app.your-domain.com
CORS_ALLOWED_ORIGINS=https://app.your-domain.com,https://staging.your-domain.com

SMTP_HOST=smtp.your-mail-provider.com
SMTP_PORT=587
SMTP_USERNAME=replace-with-smtp-username
SMTP_PASSWORD=replace-with-secret-manager-value
SMTP_FROM_EMAIL=no-reply@your-domain.com
SMTP_FROM_NAME=Pinesphere ERP
SMTP_USE_TLS=true
SMTP_USE_SSL=false

INVITE_TOKEN_EXPIRE_HOURS=48
AUTH_OTP_EXPIRE_MINUTES=10
AUTH_OTP_RESEND_COOLDOWN_SECONDS=60
AUTH_DEBUG_OTP=false
DEFAULT_REGISTRATION_ROLE=student

GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
GOOGLE_REDIRECT_URI=https://api.your-domain.com/api/v1/auth/google/callback
GOOGLE_OAUTH_STATE_EXPIRE_MINUTES=10

SMS_PROVIDER=demo
FAST2SMS_API_KEY=replace-with-fast2sms-api-key
FAST2SMS_ROUTE=q
TWILIO_ACCOUNT_SID=replace-with-twilio-account-sid
TWILIO_AUTH_TOKEN=replace-with-twilio-auth-token
TWILIO_FROM_NUMBER=replace-with-twilio-from-number
